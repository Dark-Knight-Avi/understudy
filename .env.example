# Copy to .env and fill in. NEVER commit .env
# Host credentials belong in your password manager, not here.

# --- Hosts ---
HOST_226=10.0.0.226
HOST_87=10.0.0.87
HOST_149=10.0.1.149
HOST_210=10.0.1.210

# --- Gateway (LiteLLM on .87) ---
GATEWAY_URL=http://10.0.0.87:4000
LITELLM_MASTER_KEY=

# --- Inference backends ---
VLLM_226_URL=http://10.0.0.226:8000
VLLM_87_URL=http://10.0.0.87:8000
DEEP_TIER_URL=http://10.0.0.226:8080
COMFYUI_URL=http://10.0.1.149:8188

# --- Overflow + embeddings failover (.210 -- somebody's daily workstation) ---
VLLM_210_URL=http://10.0.1.210:8000
EMBEDDINGS_FAILOVER_URL=http://10.0.1.210:7997

# --- Embeddings / rerank (.87) ---
EMBEDDINGS_URL=http://10.0.0.87:7997
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Data ---
DATABASE_URL=postgresql://aiplatform:CHANGE_ME@10.0.0.87:5432/aiplatform

# --- Fleet controller ---
FLEET_CONTROLLER_URL=http://10.0.0.87:9000

# --- Search (the only service with an egress route) ---
SEARXNG_URL=http://10.0.0.87:8888
WEB_SEARCH_ENABLED=false
