# =============================================================================
#  .226 (the model host) -- copy to .env on the host and fill in.
#  NEVER commit .env.
# =============================================================================
#  cp .env.example .env && chmod 600 .env
#
#  This host's .env carries the thing no other host's does: the exact model
#  revisions. delivery-plan.md section 8 -- "an unpinned model is an
#  unreproducible deploy" -- and docs/07 section 2 adds the trap that catches
#  people: published Q4_K_M sizes are GGUF, which is llama.cpp and Ollama.
#  vLLM's production path is AWQ, GPTQ-Int4 or FP8. Before adding any model to
#  the catalog, confirm a build exists in the format the server actually loads.
#
#  Host passwords (the Windows account behind the Task Scheduler entry) live in
#  the password manager. Not here, not anywhere in the repo.
# =============================================================================

# --- Filesystem --------------------------------------------------------------
# docs/05 section 6.3: whichever way you got the weights onto the 8 TB NVMe --
# moved VHDX, raw-disk mount, or a bind -- expose them at this SAME path as the
# other hosts so the compose files do not fork. Never /mnt/d: 9p throughput turns
# a cold load into minutes and may bottleneck mmap'd inference.
MODELS_DIR=/srv/ai-platform/models

# --- Image tags for OUR builds (rollback = edit these) -----------------------
COMFYUI_TAG=0.1.0
FLEET_AGENT_TAG=0.1.0
IK_LLAMA_TAG=0.1.0

# --- Backend API key (docs/06 section 8, layer 1) ----------------------------
# Gateway -> backend. Shared by vLLM and llama-server on this host. Low-stakes
# but not optional: without it the firewall is the only thing between the 4090
# and anyone on the subnet.
VLLM_226_KEY=

# --- Fleet agent (docs/08 section 7) -----------------------------------------
AGENT_TOKEN=
# Comma-separated process names that mean "a modelling job is running". Used by
# the deep-tier gate (docs/07 section 16) and by foreign-process attribution.
# Deliberately crude and biased toward false positives: being wrong in the
# "available" direction breaks N6.
MODELLING_PROCESS_NAMES=

# --- Fast tier (docs/07 section 5) -------------------------------------------
# Directory names under ${MODELS_DIR}. Must be vLLM-loadable builds.
# Context window for whatever the fast rung currently holds. vLLM REFUSES to
# start if this exceeds the model's max_position_embeddings, so it changes with
# the rung: Qwen3-14B is 40960, the 30B coder is far larger. Larger also costs
# KV cache, so it is a budget rather than a target.
FAST_MAX_MODEL_LEN=40960
# vLLM reserves this FRACTION OF THE WHOLE CARD immediately -- it does not grow
# into it. Measured: at 0.90 the 14B rung held 21.59 GiB and left 740 MiB free,
# which breaks the sharing policy outright.
#
#     utilization = intended footprint / total VRAM
#     0.62 x 23.99 = ~14.9 GiB  ->  ~8.5 GiB left for the person at the machine
#
# Must agree with `footprint_gb` for this rung in fleet.yaml.
FAST_GPU_UTIL=0.62
CODER_MODEL_DIR=Qwen3-Coder-30B-A3B-Instruct-AWQ
CODER_MODEL_REVISION=            # pin the exact repo revision you downloaded
FLOOR_MODEL_DIR=Qwen3-8B-Instruct-AWQ
FLOOR_MODEL_REVISION=

# --- Deep tier (docs/07 sections 10-16) --------------------------------------
# NOT started by the default profile. `docker compose --profile deep up -d`, and
# only after the deep .wslconfig profile is active and `free -g` shows ~180.
DEEP_MODEL_FILE=Qwen3-235B-A22B-Q4_K_M.gguf
DEEP_MODEL_REVISION=
# ik_llama.cpp is a fork whose flags, defaults and MoE quant types drift from
# mainline between commits. Record the commit you built; an unpinned fork is an
# unreproducible deploy.
IK_LLAMA_COMMIT=
# All three are hypotheses until M0 spike 7 sweeps them (docs/07 section 15).
# The optimum --n-cpu-moe is the SMALLEST value that still fits, and the optimum
# thread count is probably below 24 -- decode is bandwidth-bound and saturates
# the memory controllers before it saturates the cores.
DEEP_N_CPU_MOE=90
DEEP_CTX=65536
DEEP_THREADS=24

# --- Image generation (docs/15 section 4.2) ----------------------------------
# FLUX.1-schnell is Apache-2.0 and is the model we use. FLUX.1-dev is
# NON-COMMERCIAL and its paid path involves usage tracking through the vendor's
# API: that fails N2 and N1 at once. Do not deploy it.
IMAGE_MODEL_QUALITY=FLUX.1-schnell-fp8
IMAGE_MODEL_FAST=SD3.5-medium
IMAGE_MODEL_REVISION=
