# =============================================================================
#  .210 (overflow + embeddings failover) -- copy to .env on the host.
#  NEVER commit .env.
# =============================================================================
#  cp .env.example .env && chmod 600 .env
#
#  This is somebody's daily workstation. Two consequences for this file:
#   * It is the shortest .env in the fleet, and that is on purpose. Nothing
#     stateful lives here, so nothing here is expensive to lose.
#   * The person who owns this machine should be able to read this file and see
#     that it holds no surprises.
#
#  The Windows account password behind the Task Scheduler entry goes in the
#  password manager, not here -- and on this host in particular, ask before
#  storing it at all.
# =============================================================================

# --- Filesystem --------------------------------------------------------------
# The local image registry, on the hub host. Every service this repo builds is
# pulled from here; there is no Docker Hub path for any of them. Set to the
# hub's REAL address -- the repo carries a placeholder.
#
# This host's Docker daemon needs that same address in insecure-registries, and
# campus DNS in `dns`, or the pull fails (docs/05 section 5.3). The hub itself
# uses localhost:5000 instead, because WSL2 will not let a host reach its own
# LAN address.
REGISTRY=10.0.0.87:5000

MODELS_DIR=/srv/ai-platform/models

# --- Image tags for OUR builds (rollback = edit this) ------------------------
FLEET_AGENT_TAG=0.1.0

# --- Backend API keys (docs/06 section 8, layer 1) ---------------------------
VLLM_210_KEY=
INFINITY_KEY=

# --- Fleet agent -------------------------------------------------------------
AGENT_TOKEN=

# --- Embeddings replica ------------------------------------------------------
# MUST match .87's primary exactly -- same model, same revision. A replica on a
# different revision produces vectors that are silently incompatible with every
# vector already in the database (delivery-plan section 9).
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDINGS_REVISION=

# --- Burst chat capacity -----------------------------------------------------
# Directory name under ${MODELS_DIR}. AWQ / GPTQ-Int4 / FP8, never a GGUF.
SMALL_MODEL_DIR=Qwen3-8B-Instruct-AWQ
SMALL_MODEL_REVISION=
