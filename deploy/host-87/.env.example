# =============================================================================
#  .87 (the hub) -- copy to .env on the host and fill in. NEVER commit .env.
# =============================================================================
#  cp .env.example .env && chmod 600 .env
#
#  Rules, from delivery-plan.md section 8 and docs/05 section 4:
#   * Every key appears here with an empty or placeholder value. .env is
#     gitignored and written by hand on the host.
#   * HOST PASSWORDS (Windows account, Task Scheduler) live in the password
#     manager. They never appear in this file or anywhere else in the repo.
#   * If a real key ever reaches a commit, ROTATE IT. Do not rewrite history and
#     hope.
#   * Generate every secret per environment. Never reuse a dev value.
#       openssl rand -hex 32
#       LITELLM_MASTER_KEY needs the sk- prefix: echo "sk-$(openssl rand -hex 24)"
#   * Model revisions are pinned here. An unpinned model is an unreproducible
#     deploy (delivery-plan section 8).
#   * Image TAGS for OUR services live here too, because rolling back a bad
#     release is editing one line and re-running `docker compose up -d <svc>`
#     (docs/18 section 7.1). Third-party image tags are pinned inline in
#     compose.yaml instead -- bumping those is a deliberate, reviewed edit, not
#     an operational action.
# =============================================================================

# --- Host addresses (mirrors the repo-root .env.example) ---------------------
# The local image registry. Every service this repo builds is pulled from here;
# there is no Docker Hub path for any of them.
#
# LOCALHOST, not this host's LAN address -- and not a style preference. Under
# WSL2 mirrored networking a host cannot reach its OWN LAN address: .87 talking
# to 10.x.x.87:5000 gets no connection at all, while localhost:5000 answers 200.
# Docker reports that as `read: connection reset by peer` against an https:// URL
# and it reads convincingly as a TLS problem, so the hours go into
# insecure-registries rather than into the address.
#
# The other hosts DO use the LAN address -- see their .env.example. Same
# registry, same repository paths, two routes to it. An image pushed here as
# localhost:5000/x pulls elsewhere as <hub>:5000/x.
REGISTRY=localhost:5000

HOST_226=10.0.0.226
HOST_87=10.0.0.87
HOST_210=10.0.1.210
# HOST_149=10.0.1.149        # deferred, not in scope -- docs/02, delivery-plan s5

# --- Filesystem paths --------------------------------------------------------
# docs/05 section 4: identical on all hosts so the compose files do not fork.
# Both directories below MUST exist before `up`; bind-backed named volumes will
# not create them, and that failure is deliberate.
POSTGRES_DATA_DIR=/srv/ai-platform/data/postgres     # NVMe #1, Postgres alone
REGISTRY_DATA_DIR=/srv/ai-platform/data/registry     # NVMe #2
MODELS_DIR=/srv/ai-platform/models

# --- Image tags for OUR services (rollback = edit these) ---------------------
# LiteLLM moved from `main-vX.Y.Z` to plain semver; the old form no longer
# resolves. The legacy `main-stable` tag is being retired around Sept 2026, so
# pin a version rather than a moving tag. VERIFY IT PULLS before relying on it:
#     docker pull ghcr.io/berriai/litellm:$LITELLM_TAG
LITELLM_TAG=v1.88.0
FLEET_CONTROLLER_TAG=0.1.0
MCP_TOOLS_TAG=0.1.0

# --- Postgres (docs/10) ------------------------------------------------------
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=
POSTGRES_DB=aiplatform
# The platform's application database. Development runs against a SECOND
# database on this same server (delivery-plan section 3, rule 2) -- a _dev
# database, never a _dev GPU.
DATABASE_URL=postgresql://aiplatform:CHANGE_ME@postgres:5432/aiplatform
# LiteLLM gets its OWN database on the same server; it manages its own schema
# with its own migrations and mixing them makes both harder to restore.
LITELLM_DATABASE_URL=postgresql://aiplatform:CHANGE_ME@postgres:5432/litellm

# --- Gateway (docs/06 section 8) ---------------------------------------------
# Layer 2 credential. This is an ADMIN key and is NEVER given to a client;
# clients get per-surface virtual keys minted from it.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_UI_USERNAME=
LITELLM_UI_PASSWORD=

# This host's own LAN address. Caddy serves the chat UI on it as well as on
# chat.ai.lan, so the platform is reachable before *.ai.lan DNS exists.
PLATFORM_HOST=10.0.0.87

# Backend addresses. Set to this fleet's REAL host addresses -- the repo only
# ever carries placeholders. litellm.config.yaml reads these rather than
# hardcoding, so the config file is safe to commit.
VLLM_226_BASE=http://10.0.0.226:8000/v1
VLLM_210_BASE=http://10.0.1.210:8000/v1

# Layer 1 credentials: gateway -> backends. Without them the firewall is the
# only thing between the 4090 and anyone on the subnet.
VLLM_226_KEY=
VLLM_87_KEY=
VLLM_210_KEY=
INFINITY_KEY=
RAG_SERVICE_KEY=

# Per-surface virtual keys, minted with /key/generate against the master key.
# Revoking one logs out exactly one surface (docs/06 section 8).
OPEN_WEBUI_GATEWAY_KEY=
RAGFLOW_GATEWAY_KEY=

# --- Open WebUI --------------------------------------------------------------
WEBUI_SECRET_KEY=

# --- Embeddings and rerank (docs/12) -----------------------------------------
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDINGS_REVISION=                 # pin the exact revision. Changing the
                                     # embedding model invalidates every vector
                                     # in the database (delivery-plan section 9)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=

# --- vLLM floor on this host (docs/07 section 9) -----------------------------
# Directory name under ${MODELS_DIR}. Must be a build vLLM can actually load --
# AWQ / GPTQ-Int4 / FP8, never a GGUF (docs/07 section 2).
SMALL_MODEL_DIR=Qwen3-4B-Instruct-AWQ

# --- Search and egress (docs/16, ADR-0004) -----------------------------------
SEARXNG_SECRET=
# OFF by default, per workspace. The switch is the whole point of ADR-0004:
# a sensitive corpus runs air-gapped without a special deployment.
WEB_SEARCH_ENABLED=false

# --- MCP tool server (docs/14) -----------------------------------------------
MCP_TOKEN=
# Image generation shares the 4090 on .226 under admission control (docs/03).
# This is one of the two deliberate holes in the egress boundary -- see the
# networks block in compose.yaml.
COMFYUI_URL=http://10.0.0.226:8188
