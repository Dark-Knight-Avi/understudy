# =============================================================================
#  RAGFlow spike (M1.5) -- copy to .env on .87 and fill in. NEVER commit .env.
# =============================================================================
#  cp .env.example .env && chmod 600 .env
#
#  Same rules as ../.env.example: every key appears here empty or with a
#  placeholder; secrets are generated per environment (openssl rand -hex 24);
#  nothing real is ever committed. This is a SPIKE .env -- when the stack is
#  torn down (docs/m1.5-ragflow-spike.md section 9), rotate anything from the
#  main stack that was copied into it if the file ever left the host.
#
#  Third-party image tags are pinned inline in compose.yaml, per the repo
#  convention -- bumping those is a deliberate, reviewed edit, not an
#  operational action, and every one of them was verified to exist upstream
#  (see the compose header).
# =============================================================================

# --- Datastore credentials ---------------------------------------------------
# Upstream defaults all four of these to the string `infini_rag_flow`. That
# default must not survive into a running container on the hub: generate each
# one. compose.yaml refuses to start with these unset (`:?` interpolation)
# rather than quietly falling back.
#     openssl rand -hex 24
RAGFLOW_DB_PASSWORD=
RAGFLOW_ES_PASSWORD=
RAGFLOW_MINIO_PASSWORD=
RAGFLOW_REDIS_PASSWORD=

# The S3 user name RAGFlow's config template expects. Not a secret; leave it.
RAGFLOW_MINIO_USER=rag_flow

# --- Our endpoints -----------------------------------------------------------
# These two are typed into RAGFlow's model-provider UI (docs/m1.5 section 4.4),
# not read by any container -- they live here so the operator has them in one
# gitignored place instead of a scrollback buffer.
#
# The gateway virtual key minted in docs/m1.5 section 2.2 -- scoped to `chat`,
# alias `ragflow-spike`. NEVER the master key.
RAGFLOW_GATEWAY_KEY=
# Copied from ../.env -- Infinity serves embeddings to the spike exactly as it
# will serve them at M5.
INFINITY_KEY=

# --- MCP (criterion 3) -------------------------------------------------------
# RAGFlow API key for the MCP server, self-host mode. Cannot exist until the
# first account is created in the UI, so it is minted mid-procedure (docs/m1.5
# section 8.1) and the ragflow container is recreated once it is set. Until
# then compose falls back to a placeholder and MCP tool calls fail with an
# auth error -- expected, and verified as such.
RAGFLOW_API_KEY=

# --- Misc --------------------------------------------------------------------
SPIKE_TZ=Asia/Kolkata
